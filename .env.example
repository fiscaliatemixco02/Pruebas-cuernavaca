# .env.example  ->  cópialo como ".env" (en la raíz del proyecto) y llena los valores.
# El archivo .env NO debe subirse a GitHub.

# ---- Base de datos ----
DB_USER=fiscalia
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=fiscalia
# Usa 17. (Las versiones 18 o mayores guardan los datos en otra ruta; consúltalo antes de cambiarla)
POSTGRES_VERSION=17

# ---- Seguridad ----
# Un texto largo y aleatorio (mínimo 32 caracteres). Si lo cambias, todos tendrán que volver a iniciar sesión.
JWT_SECRET=CAMBIA_ESTO_POR_UN_TEXTO_LARGO_Y_ALEATORIO

# ---- Correo (para enviar el código de verificación al crear cuentas) ----
# Gmail con "contraseña de aplicación". La computadora necesita internet.
EMAIL_USER=
EMAIL_PASS=

# ---- Primer administrador ----
# Solo se usan la primera vez que arranca el sistema con la base vacía.
# Después de entrar por primera vez, borra ADMIN_PASSWORD de este archivo.
ADMIN_CORREO=
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=

# ---- Puerto por el que se entra al sistema (80 = sin escribir número) ----
PUERTO_WEB=80
